
package GroupTest;

import javax.swing.*;
import java.awt.*;

/**
 * RoundedButton - 배경 + 둥근 테두리(내부에서 직접 그림)를 지원합니다.
 * - setRoundedBorder(Color, int)로 둥근 테두리를 켤 수 있습니다.
 */
public class RoundedButton extends JButton {
    private int radius;
    private Color borderColor = null;
    private int borderThickness = 0;

    public RoundedButton(String text, int radius) {
        super(text);
        this.radius = radius;
        setContentAreaFilled(false);   // 배경 직접 그림
        setFocusPainted(false);
        setBorderPainted(false);       // 기본 경계 사용 안함 (우리가 직접 그림)
        setOpaque(false);
    }

    /**
     * 검은색 테두리 등 둥근 테두리 사용 시 호출
     * @param color 테두리 색상
     * @param thickness 테두리 두께 (픽셀)
     */
    public void setRoundedBorder(Color color, int thickness) {
        this.borderColor = color;
        this.borderThickness = Math.max(0, thickness);
        // 이 메서드가 호출되면 다시 그리기
        repaint();
    }

    @Override
    protected void paintComponent(Graphics g) {
        Graphics2D g2 = (Graphics2D) g.create();
        try {
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int w = getWidth();
            int h = getHeight();
            int bt = borderThickness;

            // 배경 (테두리 두께만큼 안쪽으로 채움)
            g2.setColor(getBackground());
            g2.fillRoundRect(bt, bt, w - bt*2 - 1, h - bt*2 - 1, radius, radius);

            // 텍스트 (직접 그림 - 기본 컴포넌트 텍스트 그리기 대신)
            g2.setFont(getFont());
            FontMetrics fm = g2.getFontMetrics();
            int textWidth = fm.stringWidth(getText());
            int textAscent = fm.getAscent();
            int x = (w - textWidth) / 2;
            int y = (h + textAscent) / 2 - 2;
            g2.setColor(getForeground());
            g2.drawString(getText(), x, y);
        } finally {
            g2.dispose();
        }
    }

    @Override
    protected void paintBorder(Graphics g) {
        if (borderColor == null || borderThickness <= 0) return;
        Graphics2D g2 = (Graphics2D) g.create();
        try {
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(borderColor);
            g2.setStroke(new BasicStroke(borderThickness));
            // borderThickness/2 보정으로 깔끔하게 보이게 함
            int off = Math.max(0, borderThickness / 2);
            g2.drawRoundRect(off, off, getWidth() - borderThickness - 1, getHeight() - borderThickness - 1, radius, radius);
        } finally {
            g2.dispose();
        }
    }

    // 기본 preferred size 약간 여유 추가 (선택)
    @Override
    public Dimension getPreferredSize() {
        Dimension d = super.getPreferredSize();
        d.width += 12;
        d.height += 6;
        return d;
    }
}
